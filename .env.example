# --- Backend / FastAPI ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Ollama (backend/app/llm) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Vectorstore / FAISS (backend/app/vectorstore, vectorstore_data/) ---
VECTORSTORE_DIR=vectorstore_data
FAISS_INDEX_PATH=vectorstore_data/index.faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K_RESULTS=5

# --- Ingestion / crawler (backend/Run_crawler.py, backend/app/ingestion) ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CRAWL_USER_AGENT=StandardAI-Crawler/1.0

# --- Frontend (Vite) ---
# Vite only exposes variables prefixed with VITE_
VITE_API_BASE_URL=http://localhost:8000

# --- Multilingual support (optional) ---
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
